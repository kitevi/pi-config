{
  "mcpServers": {
    "exa": {
      "description": "Search the live web and fetch webpage content with Exa.",
      "command": "npx",
      "args": ["-y", "exa-mcp-server"],
      "env": {
        "EXA_API_KEY": "$env:EXA_API_KEY"
      },
      "allowedTools": [
        "web_search_exa",
        "web_fetch_exa"
      ]
    },
    "context7": {
      "description": "Look up current library and framework documentation with Context7.",
      "baseUrl": "https://mcp.context7.com/mcp",
      "allowedTools": [
        "resolve-library-id",
        "query-docs"
      ]
    },
    "tinyfish": {
      "description": "Free TinyFish web search and page fetching through an auto-started stdio connection.",
      "command": "npx",
      "args": [
        "-y",
        "mcp-remote@0.14.2",
        "https://agent.tinyfish.ai/mcp",
        "--transport",
        "http-only",
        "--header",
        "X-API-Key:${TINYFISH_API_KEY}"
      ],
      "env": {
        "TINYFISH_API_KEY": "$env:TINYFISH_API_KEY"
      },
      "allowedTools": [
        "search",
        "fetch_content",
        "get_search_usage",
        "list_fetch_usage",
        "get_wallet"
      ]
    }
  },
  "imports": []
}
