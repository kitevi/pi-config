{
  "mcpServers": {
    "keenable": {
      "description": "Search the live web and fetch webpage content with Keenable.",
      "url": "https://api.keenable.ai/mcp",
      "headers": {
        "X-API-Key": "${KEENABLE_API_KEY}"
      },
      "exposure": "hidden",
      "toolExposure": {
        "search_web_pages": "codemode",
        "fetch_page_content": "codemode"
      }
    },
    "context7": {
      "description": "Look up current library and framework documentation with Context7.",
      "url": "https://mcp.context7.com/mcp",
      "exposure": "hidden",
      "toolExposure": {
        "resolve-library-id": "codemode",
        "query-docs": "codemode"
      }
    }
  }
}
