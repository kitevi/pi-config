{
  "extensions": [
    "-builtin:tool-search"
  ],
  "defaultTools": [
    "+codemode",
    "+grep",
    "+find",
    "+ls"
  ],
  "codemode": {
    "mode": "only"
  },
  "npmCommand": [
    "npm",
    "--ignore-scripts=false",
