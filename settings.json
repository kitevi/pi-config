    {
      "source": "npm:@sentiolabs/pi-frontend-design",
      "skills": [
        "skills/frontend-design"
      ]
    },
    {
      "source": "https://github.com/dmmulroy/skills",
      "skills": []
    }
  ],
  "compaction": {
    "enabled": false
  },
  "showCacheMissNotices": true,
  "readseek": {
    "replacedTools": [
      "read",
      "edit",
      "write",
      "grep"
    ],
    "imageMode": "auto",
    "syntaxValidation": "warn",
    "timeoutMs": 120000,
    "grep": {
      "maxLines": 50,
      "maxBytes": 4096
    },
    "display": {
      "read": "compact",
      "grep": "compact",
      "edit": "compact",
      "write": "compact"
    }
  }
}