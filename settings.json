        "skills/planning"
      ],
      "extensions": [],
      "prompts": [],
      "themes": []
    },
    {
      "source": "https://github.com/humanlayer/skills",
      "skills": [],
      "extensions": [],
      "prompts": [],
      "themes": []
    },
    {
      "source": "https://github.com/cursor/plugins",
      "skills": [],
      "extensions": [],
      "prompts": [],
      "themes": []
    }
  ],
  "quiet-spinner": {
    "preset": "still"
  },
  "hideThinkingBlock": true,
  "cacheWarming": "idle",
  "showCacheMissNotices": true
}
