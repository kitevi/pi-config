  "packages": [
    "https://github.com/kitevi/piref",
    "https://github.com/kitevi/pi-nudge",
    "npm:@sting8k/pi-vcc",
    "npm:@monotykamary/pi-tps",
    "npm:pi-quiet-spinner",
    "npm:@monotykamary/pi-retry",
    "npm:@monotykamary/pi-better-openai",
    "npm:pi-coralbricks-provider",
    "npm:pi-model-sort",
    "npm:pi-invisible-continue",
    "npm:pi-system-reminders",
    {
      "source": "https://github.com/mattpocock/skills",
      "skills": [
        "skills/productivity/grilling",
        "skills/productivity/handoff"
      ],
      "extensions": [],
      "prompts": [],
      "themes": []
