{
  "configVersion": 3,
  "fullCodeMode": true,
  "executor": {
    "maxOutputChars": 8192,
    "maxNestedResultChars": 2000000,
    "resultFormat": "auto"
  },
  "approvals": {
    "read": "allow",
    "write": "allow",
    "execute": "allow",
    "network": "allow",
    "agent": "deny"
  },
  "capture": {
    "enabled": true,
    "hideFromModel": true,
    "keepVisible": [
      "fabric_exec"
    ]
  },
  "mcp": {
    "enabled": true,
    "configPath": "~/.pi/agent/mcp.json",
    "disableOAuth": true,
    "allowDynamicServers": false
  },
  "agents": {
    "enabled": false,
    "maxDepth": 0,
    "retainRuns": false,
    "notifyOnComplete": false
  },
  "ui": {
    "enabled": false,
    "widget": "hidden",
    "showAgentToolPreview": false
  },
  "compaction": {
    "engine": "fabric"
  },
  "prewalk": {
    "mode": "in-place",
    "model": "opencode-go/deepseek-v4-flash",
    "thinking": "max"
  },
  "mesh": {
    "enabled": false
  },
  "memory": {
    "enabled": false
  },
  "schema": {
    "mode": "off"
  },
  "codePreview": {
    "shikiTheme": "solarized-light/solarized-dark"
  }
}
