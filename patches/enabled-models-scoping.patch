@@ -73,3 +73,28 @@
 		}
 	});
 });
+
+void describe("bootstrap pi settings", () => {
+	void it("scopes enabled models to the providers in use, hiding OpenCode Zen", async () => {
+		const home = await mkdtemp(join(tmpdir(), "pi-config-settings-"));
+
+		try {
+			await runBootstrap(home);
+
+			const settingsPath = join(home, ".pi", "agent", "settings.json");
+			const firstOutput = await readFile(settingsPath, "utf8");
+			const parsed = JSON.parse(firstOutput) as { enabledModels?: string[] };
+
+			assert.deepEqual(parsed.enabledModels, [
+				"opencode-go/*",
+				"openai-codex/*",
+				"github-copilot/*",
+			]);
+
+			await runBootstrap(home);
+			assert.equal(await readFile(settingsPath, "utf8"), firstOutput);
+		} finally {
+			await rm(home, { recursive: true, force: true });
+		}
+	});
+});
--- a/README.md
