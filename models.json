{
  "providers": {
    "openrouter": {
      "baseUrl": "https://openrouter.ai/api/v1",
      "apiKey": "$OPENROUTER_API_KEY",
      "modelOverrides": {
        "deepseek/deepseek-v4-flash": {
          "compat": {
            "sendSessionAffinityHeaders": true,
            "sessionAffinityFormat": "openrouter"
          }
        }
      }
    },
    "lilac": {
      "modelOverrides": {
        "zai-org/glm-5.2": {
          "maxTokens": 32768
        }
      }
    }
  }
}