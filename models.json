{
  "providers": {
    "openrouter": {
      "baseUrl": "https://openrouter.ai/api/v1",
      "apiKey": "$OPENROUTER_API_KEY",
      "modelOverrides": {
        "deepseek/deepseek-v4-flash": {
          "compat": {
            "sendSessionAffinityHeaders": true,
            "sessionAffinityFormat": "openrouter"
          }
        }
      }
    },
    "synthetic": {
      "modelOverrides": {
        "hf:zai-org/GLM-5.3-Flash": {
          "thinkingLevelMap": {
            "off": "none",
            "minimal": null,
            "low": "low",
            "medium": null,
            "high": "high",
            "xhigh": null,
            "max": "max"
          }
        }
      }
    }
  }
}
